# 智能域名生成器 - 环境变量示例
# 复制为 .env 后填入真实值，docker compose 会自动加载

# OpenAI 兼容服务的 API Key（必填）
OPENAI_API_KEY=sk-your-real-key

# 自定义 OpenAI 兼容服务地址（可选，默认官方）
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 微信推送：用户微信插件提供的接收 URL（可选）
# WECHAT_PUSHER_URL=https://your-wechat-plugin.example.com/webhook
# WECHAT_PUSHER_TOKEN=optional-bearer-token
# WECHAT_PUSHER_FORMAT=json
