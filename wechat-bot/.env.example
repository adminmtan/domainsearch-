# 微信 Bot 服务环境变量示例（与 .env.example 配合使用）

# Bot HTTP 端口（Flask 会通过 5002 调它）
PORT=5002

# 微信扫码登录后的状态目录（必须持久化，否则重启要重新扫码）
WECHANNEL_STATE_DIR=/data/wechannel

# Bot HTTP API 鉴权 token（Flask 通过 X-Bot-Token 头携带）
BOT_API_TOKEN=please-change-me-strong-secret

# Flask 调用 Bot 时使用的地址（同一台机器就是 127.0.0.1，跨主机改 IP）
WECHAT_BOT_URL=http://127.0.0.1:5002
WECHAT_BOT_TOKEN=please-change-me-strong-secret
